{
  "name": "AI Fitness semantic color contract",
  "version": "0.1.0-design-foundation",
  "productionArchitecture": "semantic color tokens -> theme-specific values -> platform implementation",
  "figmaStarterLimitation": {
    "reason": "The current Figma Starter plan permits only one variable mode per collection.",
    "representations": ["Color — Light", "Color — Dark"],
    "productionPattern": false,
    "parityRule": "Both Figma collections must be generated from the semanticColors array below. Names, hierarchy, scopes, and platform code syntax must match exactly; only primitive aliases may differ."
  },
  "codeSyntax": {
    "web": "var(--ai-color-{slash-path-as-kebab})",
    "android": "AiTheme.colors.{slash-path-as-camel}",
    "ios": "AITheme.Color.{slash-path-as-camel}"
  },
  "primitives": {
    "neutral/0": "#FFFFFF",
    "neutral/50": "#F6F8F7",
    "neutral/100": "#EDF2F0",
    "neutral/200": "#D9E2DE",
    "neutral/300": "#BBC9C3",
    "neutral/400": "#8FA199",
    "neutral/450": "#7A8C85",
    "neutral/500": "#6B7E76",
    "neutral/550": "#596D66",
    "neutral/600": "#4B5F59",
    "neutral/700": "#344842",
    "neutral/800": "#20342F",
    "neutral/900": "#10221E",
    "neutral/950": "#081411",
    "cadence/50": "#EDFCF8",
    "cadence/100": "#D2F7ED",
    "cadence/200": "#A8EEDA",
    "cadence/300": "#72E0C1",
    "cadence/400": "#3BCDB0",
    "cadence/500": "#14AC91",
    "cadence/600": "#087F6B",
    "cadence/700": "#066B5B",
    "cadence/800": "#085449",
    "cadence/900": "#073F37",
    "cadence/950": "#032822",
    "pulse/50": "#FFF4ED",
    "pulse/100": "#FFE6D5",
    "pulse/200": "#FFC9A8",
    "pulse/300": "#FFA16F",
    "pulse/400": "#F47A46",
    "pulse/500": "#E85B2A",
    "pulse/600": "#C74B22",
    "pulse/700": "#9E331B",
    "pulse/800": "#7E2B1E",
    "pulse/900": "#65251C",
    "pulse/950": "#38140D",
    "green/50": "#ECFDF3",
    "green/300": "#75E0A7",
    "green/600": "#16794A",
    "green/900": "#0B3B25",
    "amber/50": "#FFFAEB",
    "amber/300": "#FEC84B",
    "amber/600": "#A15C00",
    "amber/700": "#854A0E",
    "amber/900": "#542C0A",
    "red/50": "#FEF3F2",
    "red/300": "#FDA29B",
    "red/600": "#B42318",
    "red/700": "#912018",
    "red/900": "#55160C",
    "blue/50": "#EFF8FF",
    "blue/300": "#84CAFF",
    "blue/600": "#1D63B8",
    "blue/700": "#184E8F",
    "blue/900": "#102A56",
    "overlay/ink-72": "#081411B8",
    "overlay/white-12": "#FFFFFF1F"
  },
  "semanticColors": [
    {"name":"background/base","light":"neutral/50","dark":"neutral/950","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"background/sunken","light":"neutral/100","dark":"neutral/950","scopes":["FRAME_FILL","SHAPE_FILL"],"intentionalDifference":"Dark mode cannot recess below the base ink without crushing contrast; boundaries and surrounding elevation provide the second cue."},
    {"name":"background/elevated","light":"neutral/0","dark":"neutral/900","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"surface/default","light":"neutral/0","dark":"neutral/900","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"surface/raised","light":"neutral/0","dark":"neutral/800","scopes":["FRAME_FILL","SHAPE_FILL"],"intentionalDifference":"Light mode primarily uses shadow and border for elevation; dark mode uses a lighter surface tone because shadows have reduced visual utility."},
    {"name":"surface/interactive","light":"neutral/50","dark":"neutral/800","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"surface/disabled","light":"neutral/100","dark":"neutral/800","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"text/primary","light":"neutral/900","dark":"neutral/0","scopes":["TEXT_FILL"]},
    {"name":"text/secondary","light":"neutral/600","dark":"neutral/300","scopes":["TEXT_FILL"]},
    {"name":"text/tertiary","light":"neutral/550","dark":"neutral/400","scopes":["TEXT_FILL"]},
    {"name":"text/disabled","light":"neutral/550","dark":"neutral/400","scopes":["TEXT_FILL"],"intentionalDifference":"Disabled meaning is carried by interaction state, surface, border, and optional icon—not reduced text contrast. Text remains at least 4.5:1."},
    {"name":"text/inverse","light":"neutral/0","dark":"neutral/950","scopes":["TEXT_FILL"],"intentionalDifference":"Inverse means content placed on the current theme's contrasting filled surface, not a fixed white token."},
    {"name":"text/on-accent","light":"neutral/0","dark":"neutral/950","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"border/default","light":"neutral/450","dark":"neutral/500","scopes":["STROKE_COLOR"]},
    {"name":"border/strong","light":"neutral/600","dark":"neutral/400","scopes":["STROKE_COLOR"]},
    {"name":"border/focus","light":"cadence/600","dark":"cadence/300","scopes":["STROKE_COLOR"]},
    {"name":"border/disabled","light":"neutral/450","dark":"neutral/500","scopes":["STROKE_COLOR"]},
    {"name":"accent/primary","light":"cadence/600","dark":"cadence/300","scopes":["FRAME_FILL","SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"accent/primary-hover","light":"cadence/700","dark":"cadence/200","scopes":["FRAME_FILL","SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"accent/primary-pressed","light":"cadence/800","dark":"cadence/400","scopes":["FRAME_FILL","SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"accent/subtle","light":"cadence/100","dark":"cadence/900","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"accent/on-primary","light":"neutral/0","dark":"neutral/950","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"accent/warm","light":"pulse/600","dark":"pulse/300","scopes":["FRAME_FILL","SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"accent/warm-subtle","light":"pulse/50","dark":"pulse/900","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"accent/on-warm","light":"neutral/0","dark":"neutral/950","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"status/success","light":"green/600","dark":"green/300","scopes":["SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"status/success-subtle","light":"green/50","dark":"green/900","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"status/on-success","light":"neutral/0","dark":"neutral/950","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"status/warning","light":"amber/600","dark":"amber/300","scopes":["SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"status/warning-subtle","light":"amber/50","dark":"amber/900","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"status/on-warning","light":"neutral/0","dark":"neutral/950","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"status/error","light":"red/600","dark":"red/300","scopes":["SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"status/error-subtle","light":"red/50","dark":"red/900","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"status/on-error","light":"neutral/0","dark":"neutral/950","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"status/info","light":"blue/600","dark":"blue/300","scopes":["SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"status/info-subtle","light":"blue/50","dark":"blue/900","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"status/on-info","light":"neutral/0","dark":"neutral/950","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"selection/background","light":"cadence/100","dark":"cadence/900","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"selection/content","light":"cadence/800","dark":"cadence/200","scopes":["TEXT_FILL","SHAPE_FILL","STROKE_COLOR"]},
    {"name":"control/primary","light":"cadence/600","dark":"cadence/300","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"control/primary-hover","light":"cadence/700","dark":"cadence/200","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"control/primary-pressed","light":"cadence/800","dark":"cadence/400","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"control/disabled","light":"neutral/200","dark":"neutral/700","scopes":["FRAME_FILL","SHAPE_FILL"]},
    {"name":"control/on-primary","light":"neutral/0","dark":"neutral/950","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"focus/ring","light":"cadence/600","dark":"cadence/300","scopes":["STROKE_COLOR"]},
    {"name":"chart/series-1","light":"cadence/700","dark":"cadence/300","scopes":["SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"chart/series-2","light":"blue/600","dark":"blue/300","scopes":["SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"chart/series-3","light":"pulse/600","dark":"pulse/300","scopes":["SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"chart/series-4","light":"green/600","dark":"green/300","scopes":["SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"chart/series-5","light":"amber/600","dark":"amber/300","scopes":["SHAPE_FILL","TEXT_FILL","STROKE_COLOR"]},
    {"name":"metric/positive","light":"green/600","dark":"green/300","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"metric/caution","light":"amber/600","dark":"amber/300","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"metric/negative","light":"red/600","dark":"red/300","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"metric/neutral","light":"neutral/600","dark":"neutral/300","scopes":["TEXT_FILL","SHAPE_FILL"]},
    {"name":"overlay/scrim","light":"overlay/ink-72","dark":"overlay/ink-72","scopes":["FRAME_FILL","SHAPE_FILL"]}
  ]
}
